# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Perplexity API Key (for Web Research feature)
# Get from https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Context API Key (for Company Brand Data + LinkedIn features)
# This key unlocks both sources
CONTEXT_API_KEY=

# Agent Bridge Secret (for Agent conversation/prompting features)
# Must match the value in your agent process
AGENT_BRIDGE_SECRET=

# PostgreSQL Connection String (if using direct Postgres instead of Supabase)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://crm:crm_secret@localhost:5432/crm
